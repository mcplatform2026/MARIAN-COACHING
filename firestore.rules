rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthorizedEmail() {
      return isSignedIn() && 
             request.auth.token.email != null && 
             request.auth.token.email.lower() in [
               'jeff@mariancoaching.com',
               'jeffrey.marian@gmail.com',
               'mcplatform2026@gmail.com'
             ];
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCollaboratorOnData(docData) {
      let isEmailCollab = request.auth.token.email != null && (
        docData.get('collaboratorEmail', '') == request.auth.token.email ||
        request.auth.token.email in docData.get('allowedCollaborators', [])
      );
      
      let isUidCollab = request.auth.uid != null && (
        docData.get('collaboratorUid', '') == request.auth.uid ||
        request.auth.uid in docData.get('allowedCollaborators', [])
      );
      
      return isEmailCollab || isUidCollab;
    }

    function isCollaborator(userId) {
      let ownerDoc = get(/databases/$(database)/documents/users/$(userId));
      let isCollabOnUserDoc = ownerDoc != null && isCollaboratorOnData(ownerDoc.data);
      
      let collabEmail = request.auth.token.email;
      let collabDoc = collabEmail != null ? get(/databases/$(database)/documents/collaborators/$(collabEmail)) : null;
      let isCollabOnCollabCollection = collabDoc != null && collabDoc.data.ownerUid == userId;
      return isCollabOnUserDoc || isCollabOnCollabCollection;
    }

    match /users/{userId} {
      allow read, write: if isAuthorizedEmail();
                   
      match /invoices/{invoiceId} {
        allow read: if true;
        allow write: if isAuthorizedEmail();
      }

      match /agreements/{agreementId} {
        allow read: if true;
        allow update: if isAuthorizedEmail() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'viewedAt', 'acceptedAt', 'clientSignature']));
        allow write: if isAuthorizedEmail();
      }

      match /{allSubcollections=**} {
        allow read, write: if isAuthorizedEmail();
      }
    }

    match /collaborators/{email} {
      allow get: if isAuthorizedEmail() && request.auth.token.email.lower() == email.lower();
      allow list: if isAuthorizedEmail();
      allow write: if isAuthorizedEmail();
    }
    
    // Very short links for public sharing
    match /shared_links/{shortId} {
      allow read: if true;
      allow write: if isAuthorizedEmail();
    }
    
    // Legacy shared invoices for public client views
    match /shared_invoices/{shortId} {
      allow read: if true;
      allow write: if isAuthorizedEmail();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
