rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Strictly restricts administrator operations to your 3 designated accounts
    function isAuthorizedEmail() {
      return isSignedIn() && 
             request.auth.token.email != null && 
             request.auth.token.email.lower() in [
               'jeff@mariancoaching.com',
               'jeffrey.marian@gmail.com',
               'mcplatform2026@gmail.com'
             ];
    }

    // User workspaces, clients, sessions, transactions, preferences, and tasks
    match /users/{userId} {
      allow read, write: if isAuthorizedEmail();
                   
      // Invoices: Clients can view via public link; creating/updating requires authorized admin
      match /invoices/{invoiceId} {
        allow read: if true;
        allow write: if isAuthorizedEmail();
      }

      // Agreements: Clients can view and submit e-signature in any browser / incognito mode; editing requires authorized admin
      match /agreements/{agreementId} {
        allow read: if true;
        allow update: if isAuthorizedEmail() || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'viewedAt', 'acceptedAt', 'clientSignature'])
        );
        allow write: if isAuthorizedEmail();
      }

      // Covers all present and future nested subcollections automatically
      match /{allSubcollections=**} {
        allow read, write: if isAuthorizedEmail();
      }
    }

    // Collaborators collection
    match /collaborators/{email} {
      allow get: if isAuthorizedEmail() && request.auth.token.email.lower() == email.lower();
      allow list: if isAuthorizedEmail();
      allow write: if isAuthorizedEmail();
    }
    
    // Public short links for shared documents (agreements & invoices)
    // Accessible by anyone in incognito or any browser without an account
    match /shared_links/{shortId} {
      allow read: if true;
      allow update: if isAuthorizedEmail() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data']);
      allow create, delete: if isAuthorizedEmail();
    }
    
    // Public short links for shared invoices
    match /shared_invoices/{shortId} {
      allow read: if true;
      allow write: if isAuthorizedEmail();
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
